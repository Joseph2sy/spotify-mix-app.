# Copia este archivo como .streamlit/secrets.toml en local,
# o pega su contenido en "Settings → Secrets" de Streamlit Cloud.
# NUNCA subas este archivo con claves reales a un repositorio público.

SPOTIPY_CLIENT_ID = "tu_client_id_de_spotify"
SPOTIPY_CLIENT_SECRET = "tu_client_secret_de_spotify"
SPOTIPY_REDIRECT_URI = "https://tu-app.streamlit.app"

# Opcional. Si no la defines, la app funciona igual con el motor local
# (el Auto-Mix nunca depende de esta clave para funcionar).
OPENAI_API_KEY = "sk-..."
